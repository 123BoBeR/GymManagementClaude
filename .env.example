SECRET_KEY=zmien-na-losowy-klucz-produkcyjny

# Tryb: w 'production' SECRET_KEY jest wymagany, a ciasteczko sesji dostaje
# flage Secure (https). Domyslnie tryb deweloperski.
# FLASK_ENV=production

# Debug serwera deweloperskiego (1 = wlaczony). Domyslnie wylaczony.
# UWAGA: nigdy nie wlaczaj w produkcji (zdalne wykonanie kodu).
# FLASK_DEBUG=1

# SQLite (development):
DATABASE_URL=sqlite:///gym.db

# PostgreSQL (produkcja) - odkomentuj i uzupelnij:
# DATABASE_URL=postgresql://user:password@localhost:5432/gymmanagement
